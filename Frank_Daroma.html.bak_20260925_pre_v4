function reliabilityBadge(rel) {
  if (rel === 'RELIABLE') return '<span class="reliability-badge rel-reliable">RELIABLE</span>';
  if (rel === 'CONSISTENT') return '<span class="reliability-badge rel-consistent">CONSISTENT</span>';
  if (rel === 'MIXED') return '<span class="reliability-badge rel-mixed">MIXED</span>';
  if (rel === 'UNRELIABLE') return '<span class="reliability-badge rel-unreliable">UNRELIABLE</span>';
  return '<span class="reliability-badge rel-pending">PENDING</span>';
}

function metricColor(score) {
  if (score >= 8.0) return 'var(--success)';
  if (score >= 7.0) return 'var(--gold)';
  if (score >= 6.0) return 'var(--warning)';
  return 'var(--danger)';
}

