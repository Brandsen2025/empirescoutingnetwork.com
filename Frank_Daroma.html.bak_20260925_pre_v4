  var banners = [];
  if (season.fga !== null) {
    banners.push({type:'banner-warning', text:'<span>PROVISIONAL</span> <strong>FGA Rating 7.3–7.9 — "Very Good".</strong> Do not quote a single number until Tier 1 is verified.'});
    banners.push({type:'banner-danger', text:'<span>BLOCKER</span> <strong>Tier 1 career data is unverified.</strong> Secondary aggregator pages only. FBref is bot-blocked. Verify every figure before client use.'});
    banners.push({type:'banner-verified', text:'<span>VALIDATED</span> <strong>134 video events across 7 matches.</strong> Balance check passed: 2 vs top-third, 2 away, 1 while losing. T3 complete at 11/12 metrics.'});
  } else {
    banners.push({type:'banner-info', text:'<span>INFO</span> <strong>TIER 1 DATA ONLY.</strong> ' + season.label + ' has not been video-graded. FGA v3 score pending Tier 3 assessment.'});
  }
  renderBanners(banners, 'overviewBanners');

  var profileCards = [
    {title:'Player Profile', content:'<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px 20px;font-size:0.85rem;line-height:1.6;"><div><strong>Full Name:</strong> Frank Daroma</div><div><strong>Date of Birth:</strong> 12 April 2001</div><div><strong>Place of Birth:</strong> Freetown, Sierra Leone</div><div><strong>Nationality:</strong> Sierra Leone</div><div><strong>Height:</strong> 163 cm (5 ft 4 in)</div><div><strong>Weight:</strong> 60 kg (132 lb)</div><div><strong>Position:</strong> CM / DM</div><div><strong>Foot:</strong> Right</div><div><strong>Current Club:</strong> Colorado Springs Switchbacks</div><div><strong>Contract:</strong> To 30 Nov 2027</div></div>'},
    {title:'T3 Status', content: season.fga !== null ? '<strong style="color:var(--success);">VIDEO GRADED — 11/12 metrics.</strong> Tier 3 average: <strong>7.79</strong>. OBI Composite 7.64, SII Composite 7.57. MCS below threshold (2 matches).' : '<strong style="color:var(--warning);">Not Assessed.</strong> Tier 1 statistical data only. Video assessment pending.'},
    {title:'Empire FGA Verdict', content: season.fga !== null ? '<strong style="color:var(--text-primary);">PROVISIONAL 7.3–7.9 — Verratti Archetype 79%.</strong> Elite ball retention, press-resistant, calm under pressure. Development areas: creative risk, dynamism, run timing. Not client-ready until Tier 1 verified.' : '<strong style="color:var(--text-primary);">Tier 1 Statistical Profile.</strong> ' + g + ' goals in ' + ap + ' apps for ' + season.club + '. Video assessment pending.'}
  ];
  renderProfileCards(profileCards, 'overviewProfileCards');

  var philosophyFits = [
    {rank:1, name:'Guardiola — Positional Midfielder', width:'82%', color:'#009b3a', score:'8.2'},
    {rank:2, name:'Wenger — Creative Midfielder', width:'78%', color:'#009b3a', score:'7.8'},
    {rank:3, name:'Klopp — Gegenpress Midfielder', width:'72%', color:'#27ae60', score:'7.2'},
    {rank:4, name:'Ancelotti — Balanced Midfielder', width:'68%', color:'#e07820', score:'6.8'},
    {rank:5, name:'Mourinho — Tactical Midfielder', width:'64%', color:'#3498db', score:'6.4'}
  ];
  renderPhilosophyFits(philosophyFits, 'philosophyFits');

  var recText = season.fga !== null
    ? '<span class="tag tag-warning" style="font-size:0.85rem;padding:6px 18px;">PROVISIONAL 7.3–7.9</span> <div style="flex:1;font-size:0.85rem;color:var(--text-secondary);line-height:1.6;"><strong style="color:var(--text-primary);">Ball-Retention Midfielder — Verratti Archetype 79%.</strong> Elite ball retention (CLM 8.60/100%), space awareness (OBI_S 8.40/100%), one-touch and horizontal passing (OTP 7.80/100%, HZP 7.71/100%). Development: creative risk, dynamism, run timing. Not client-ready.</div> <div style="font-family:var(--font-heading);font-size:0.7rem;color:var(--text-tertiary);text-align:right;white-space:nowrap;">T3 Complete</div>'
    : '<span class="tag tag-info" style="font-size:0.85rem;padding:6px 18px;">TIER 1 PROFILE</span> <div style="flex:1;font-size:0.85rem;color:var(--text-secondary);line-height:1.6;"><strong style="color:var(--text-primary);">' + season.label + '.</strong> ' + ap + ' apps, ' + g + ' goals, ' + a + ' assists. Video assessment pending for full FGA v3 grade.</div> <div style="font-family:var(--font-heading);font-size:0.7rem;color:var(--text-tertiary);text-align:right;white-space:nowrap;">Tier 1</div>';
  renderRecommendation(recText, 'recommendationCard');

  renderFGA();
  renderCrossLeague(id);
  renderPhilosophy();
  renderScouting();
  renderMatches();
  renderLastMatches();
  renderAttributeCards();

  if (season.fga !== null) updateDial(7.6); else updateDial(0);
  initCharts();
}

function switchTab(id) {
  var panels = document.querySelectorAll('.tab-panel');
  var buttons = document.querySelectorAll('.tab-btn');
  for (var i = 0; i < panels.length; i++) panels[i].classList.remove('active');
  for (var j = 0; j < buttons.length; j++) buttons[j].classList.remove('active');
  var panel = document.getElementById(id);
  if (panel) panel.classList.add('active');
  for (var k = 0; k < buttons.length; k++) {
    if (buttons[k].getAttribute('data-tab') === id) buttons[k].classList.add('active');
  }
  if (id === 'attributes' || id === 'philosophy') setTimeout(initCharts, 50);
}

window.switchTab = switchTab;
window.updateSeason = updateSeason;

function init() {
  var select = document.getElementById('seasonSelect');
  if (select) {
    select.innerHTML = '';
    careerSeasons.forEach(function(s){
      var opt = document.createElement('option');
      opt.value = s.id;
      opt.textContent = s.label;
      select.appendChild(opt);
    });
    select.value = '2026-27';
  }
  renderCareerTimeline();
  renderCareerStatsTable();
  renderHonours();
  updateSeason();
  initCharts();
  var btns = document.querySelectorAll('.tab-btn');
  for (var i = 0; i < btns.length; i++) {
    btns[i].addEventListener('click', function(){
      var tab = this.getAttribute('data-tab');
      if (tab) switchTab(tab);
    });
  }
}
if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
else init();
</script>
