function updateDial(score) {
  var canvas = document.getElementById('heroDial'); if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var max = 10;
  var angle = (score / max) * 1.5 * Math.PI + 0.75 * Math.PI;
  ctx.clearRect(0,0,150,150);
  ctx.beginPath();
  ctx.arc(75,75,62,0.75*Math.PI,2.25*Math.PI);
  ctx.strokeStyle = 'rgba(255,255,255,0.08)';
  ctx.lineWidth = 8; ctx.lineCap = 'round'; ctx.stroke();
  ctx.beginPath();
  ctx.arc(75,75,62,0.75*Math.PI,angle);
  ctx.strokeStyle = '#fbbf24';
  ctx.lineWidth = 8; ctx.lineCap = 'round'; ctx.stroke();
}

