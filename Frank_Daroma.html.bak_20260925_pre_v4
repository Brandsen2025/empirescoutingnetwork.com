// CROSS-LEAGUE — CORRECTED FORMULA
// Adjusted FGA = Base FGA × (Source LOG ÷ Target LOG)
// ============================================================
function renderCrossLeague(seasonId) {
  var season = careerSeasons.find(function(s){return s.id === seasonId;});
  if (!season) return;

  var sourceLog = season.logTier;
  var sourceGoals = season.goals || 0;
  var sourceAssists = season.assists || 0;
  var sourceFga = 7.6; // provisional midpoint

  var grid = document.getElementById('crossLeagueGrid'); if (!grid) return;
  grid.innerHTML = '';
  crossLeagues.forEach(function(leagueName){
    var ref = logReference[leagueName]; if (!ref) return;
    // CORRECTED: Source LOG ÷ Target LOG
    var ratio = sourceLog / ref.tier;
    var projGA = (sourceGoals + sourceAssists) * ratio;
    var projFga = sourceFga * ratio;
    var direction = ref.tier > sourceLog ? 'down' : (ref.tier < sourceLog ? 'up' : 'same');
    var directionText = ref.tier > sourceLog ? 'TOUGHER LEAGUE — score scales down' : (ref.tier < sourceLog ? 'EASIER LEAGUE — score scales up' : 'SAME LEVEL');
    var card = document.createElement('div');
    card.className = 'league-compare-card';
    card.innerHTML = '<div class="league-flag">'+ref.code+'</div>' +
      '<div class="league-name">'+leagueName+'</div>' +
      '<div class="league-tier">'+ref.short+' | LOG '+ref.tier.toFixed(1)+'</div>' +
      '<div class="projected-goals">'+projFga.toFixed(1)+'</div>' +
      '<div class="projected-label">Adjusted FGA</div>' +
      '<div class="multiplier">Multiplier: <strong>'+ratio.toFixed(2)+'x</strong></div>' +
      '<div class="log-badge">G+A proj: '+projGA.toFixed(1)+'</div>' +
      '<div class="direction-indicator"><span class="'+(direction==='down'?'down':(direction==='up'?'up':''))+'">'+directionText+'</span></div>';
    grid.appendChild(card);
  });
}

