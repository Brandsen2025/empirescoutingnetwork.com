<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Frank Daroma | Empire FGA Intelligence Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@300;400;500;600;700&family=Oswald:wght@200;300;400;500;600;700&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<style>
:root{--bg-primary:#0a0a0f;--bg-card:#0f0f1a;--bg-card-hover:#151525;--border-subtle:rgba(255,255,255,0.06);--border-medium:rgba(255,255,255,0.1);--text-primary:#f0f0f5;--text-secondary:#9b9bb0;--text-tertiary:#5a5a70;--accent:#d4a020;--accent-dim:rgba(212,160,32,0.15);--gold:#fbbf24;--gold-dim:rgba(251,191,36,0.15);--silver:#94a3b8;--success:#00d084;--warning:#ffb800;--danger:#ff3b3b;--info:#3b82f6;--teal:#00c5a8;--tier1:#00d084;--tier2:#ffb800;--tier3:#d4a020;--pending:#5a5a70;--font-display:'Oswald',sans-serif;--font-heading:'Rajdhani',sans-serif;--font-body:'DM Sans',sans-serif;}
*{margin:0;padding:0;box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{font-family:var(--font-body);background:var(--bg-primary);color:var(--text-primary);line-height:1.6;overflow-x:hidden;}
::-webkit-scrollbar{width:6px;}
::-webkit-scrollbar-track{background:var(--bg-primary);}
::-webkit-scrollbar-thumb{background:var(--accent);border-radius:3px;}
.hero{position:relative;height:540px;overflow:hidden;border-bottom:1px solid var(--border-subtle);}
.hero-photo{position:absolute;inset:0;background:url('https://ewscripps.brightspotcdn.com/dims4/default/2f0a730/2147483647/strip/true/crop/3372x1770+0+450/resize/1200x630!/quality/90/?url=http%3A%2F%2Fewscripps-brightspot.s3.amazonaws.com%2Fdd%2Fa3%2Fb0218a294110b47420024a52569d%2Fdaroma-frank-1.JPG') center 25% / cover no-repeat;filter:brightness(0.45) saturate(0.9);transition:transform 8s ease;}
.hero:hover .hero-photo{transform:scale(1.03);}
.hero-overlay{position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,10,15,0.3) 0%,rgba(212,160,32,0.2) 40%,rgba(10,10,15,0.85) 70%,var(--bg-primary) 100%);}
.hero-branding{position:absolute;top:0;left:0;right:0;height:5px;background:linear-gradient(90deg,#d4a020 33%,#fbbf24 33%,#fbbf24 66%,#d4a020 66%);z-index:10;}
.champ-badge{position:absolute;top:20px;right:24px;z-index:5;background:linear-gradient(135deg,var(--accent),#0f172a);padding:6px 14px;border-radius:8px;font-family:var(--font-heading);font-size:0.65rem;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--gold);border:1px solid rgba(251,191,36,0.3);display:flex;align-items:center;gap:6px;}
.champ-badge::before{content:'SLE';font-size:0.7rem;font-weight:800;}
.hero-content{position:relative;z-index:5;max-width:1200px;margin:0 auto;padding:40px 24px 0;height:100%;display:flex;flex-direction:column;justify-content:flex-end;}
.jersey-watermark{position:absolute;top:50%;right:5%;transform:translateY(-50%);font-family:var(--font-display);font-size:240px;font-weight:700;color:rgba(251,191,36,0.04);line-height:1;pointer-events:none;z-index:2;}
.club-badge-strip{display:flex;align-items:center;gap:6px;margin-bottom:10px;flex-wrap:wrap;}
.badge-item{display:flex;align-items:center;gap:4px;background:rgba(255,255,255,0.06);backdrop-filter:blur(10px);padding:2px 7px;border-radius:100px;border:1px solid var(--border-subtle);font-family:var(--font-heading);font-size:0.58rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.5px;white-space:nowrap;}
.badge-item .arrow{color:var(--text-tertiary);font-size:0.6rem;}
.badge-item.current{background:var(--accent-dim);border-color:rgba(148,163,184,0.3);color:var(--silver);}
.hero-name{font-family:var(--font-display);font-size:clamp(2.5rem,6vw,4.5rem);font-weight:700;line-height:1.05;text-transform:uppercase;letter-spacing:-1px;margin-bottom:8px;background:linear-gradient(135deg,#fff 0%,var(--silver) 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
.hero-meta{display:flex;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:24px;}
.hero-meta span{font-family:var(--font-heading);font-size:0.95rem;color:var(--text-secondary);display:flex;align-items:center;gap:6px;}
.hero-meta .dot{width:4px;height:4px;background:var(--gold);border-radius:50%;}
.hero-meta .flag{font-size:1.1rem;font-weight:700;color:var(--gold);}
.hero-bottom{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap;padding-bottom:32px;}
.hero-tags{display:flex;flex-wrap:wrap;gap:8px;}
.tag{padding:5px 12px;border-radius:6px;font-family:var(--font-heading);font-size:0.72rem;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;}
.tag-pending{background:rgba(90,96,112,0.2);color:var(--pending);border:1px solid rgba(90,96,112,0.3);}
.tag-club{background:var(--accent-dim);color:var(--silver);border:1px solid rgba(148,163,184,0.25);}
.tag-gold{background:var(--gold-dim);color:var(--gold);border:1px solid rgba(251,191,36,0.25);}
.tag-value{background:rgba(0,208,132,0.1);color:var(--success);border:1px solid rgba(0,208,132,0.2);}
.tag-info{background:rgba(59,130,246,0.1);color:var(--info);border:1px solid rgba(59,130,246,0.2);}
.tag-danger{background:rgba(255,59,59,0.1);color:var(--danger);border:1px solid rgba(255,59,59,0.2);}
.tag-verified{background:rgba(0,208,132,0.12);color:var(--success);border:1px solid rgba(0,208,132,0.2);}
.tag-warning{background:rgba(255,184,0,0.12);color:var(--warning);border:1px solid rgba(255,184,0,0.2);}
.tag-record{background:rgba(212,160,32,0.15);color:var(--gold);border:1px solid rgba(212,160,32,0.3);}
.tag-era{background:rgba(0,197,168,0.12);color:var(--teal);border:1px solid rgba(0,197,168,0.25);}
.fga-dial-wrap{position:relative;width:150px;height:150px;flex-shrink:0;}
.fga-dial-inner{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;}
.fga-dial-inner .fga-label{font-family:var(--font-heading);font-size:0.6rem;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:var(--text-tertiary);}
.fga-dial-inner .fga-score{font-family:var(--font-display);font-size:1.65rem;font-weight:700;color:var(--gold);line-height:1;}
.fga-dial-inner .fga-status{font-family:var(--font-heading);font-size:0.55rem;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;color:var(--warning);margin-top:2px;}
.tier-pills{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap;}
.tier-pill{display:flex;align-items:center;gap:6px;padding:4px 10px;border-radius:100px;font-family:var(--font-heading);font-size:0.65rem;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;}
.tier-pill.t1{background:rgba(0,208,132,0.12);color:var(--tier1);border:1px solid rgba(0,208,132,0.2);}
.tier-pill.t2{background:rgba(255,184,0,0.12);color:var(--tier2);border:1px solid rgba(255,184,0,0.2);}
.tier-pill.t3{background:rgba(212,160,32,0.12);color:var(--tier3);border:1px solid rgba(212,160,32,0.2);}
.season-selector{display:flex;align-items:center;gap:16px;margin-bottom:20px;flex-wrap:wrap;background:var(--bg-card);padding:16px 20px;border-radius:12px;border:1px solid var(--border-subtle);}
.season-selector label{font-family:var(--font-heading);font-size:0.85rem;font-weight:600;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.5px;}
.season-selector select{background:var(--bg-primary);color:var(--text-primary);border:1px solid var(--border-medium);border-radius:8px;padding:8px 16px;font-family:var(--font-heading);font-size:0.9rem;font-weight:500;cursor:pointer;outline:none;min-width:340px;}
.season-selector select:hover{border-color:var(--accent);}
.season-selector select option{background:var(--bg-primary);color:var(--text-primary);}
.season-average{font-family:var(--font-heading);font-size:0.85rem;color:var(--text-secondary);margin-left:auto;padding:4px 12px;background:var(--accent-dim);border-radius:100px;border:1px solid rgba(212,160,32,0.2);display:flex;align-items:center;gap:8px;}
.season-average strong{color:var(--gold);font-size:1rem;}
.trend-arrow{font-size:1.2rem;line-height:1;}
.trend-up{color:var(--success);}
.trend-down{color:var(--danger);}
.trend-flat{color:var(--text-tertiary);}
.tab-bar{position:sticky;top:0;z-index:100;background:rgba(10,10,15,0.92);backdrop-filter:blur(16px);border-bottom:1px solid var(--border-subtle);}
.tab-bar-inner{max-width:1200px;margin:0 auto;display:flex;overflow-x:auto;scrollbar-width:none;gap:0;}
.tab-bar-inner::-webkit-scrollbar{display:none;}
.tab-btn{flex:1;min-width:110px;padding:16px 8px;background:none;border:none;border-bottom:2px solid transparent;color:var(--text-tertiary);font-family:var(--font-heading);font-size:0.8rem;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;cursor:pointer;transition:all 0.2s;white-space:nowrap;}
.tab-btn:hover{color:var(--text-secondary);}
.tab-btn.active{color:var(--silver);border-bottom-color:var(--silver);background:linear-gradient(180deg,transparent 0%,var(--accent-dim) 100%);}
.content{max-width:1200px;margin:0 auto;padding:32px 24px;}
.tab-panel{display:none;}
.tab-panel.active{display:block;animation:fadeIn 0.3s ease;}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}
.section-title{font-family:var(--font-display);font-size:1.4rem;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;margin-bottom:20px;display:flex;align-items:center;gap:10px;}
.section-title .line{flex:1;height:1px;background:var(--border-subtle);}
.card{background:var(--bg-card);border:1px solid var(--border-subtle);border-radius:12px;padding:24px;margin-bottom:20px;transition:border-color 0.2s,background 0.2s;}
.card:hover{background:var(--bg-card-hover);border-color:var(--border-medium);}
.grid-2{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;}
.grid-3{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;}
.grid-4{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;}
.banner{padding:14px 18px;border-radius:8px;margin-bottom:20px;display:flex;align-items:center;flex-wrap:wrap;gap:12px;font-family:var(--font-heading);font-size:0.9rem;font-weight:500;}
.banner-info{background:rgba(59,130,246,0.08);border:1px solid rgba(59,130,246,0.2);color:var(--info);}
.banner-warning{background:rgba(255,184,0,0.08);border:1px solid rgba(255,184,0,0.2);color:var(--warning);}
.banner-verified{background:rgba(0,208,132,0.08);border:1px solid rgba(0,208,132,0.2);color:var(--success);}
.banner-era{background:rgba(0,197,168,0.08);border:1px solid rgba(0,197,168,0.2);color:var(--teal);}
.banner-gold{background:rgba(251,191,36,0.08);border:1px solid rgba(251,191,36,0.2);color:var(--gold);}
.banner-danger{background:rgba(255,59,59,0.08);border:1px solid rgba(255,59,59,0.2);color:var(--danger);}
.banner-champ{background:linear-gradient(135deg,rgba(212,160,32,0.1),rgba(251,191,36,0.05));border:1px solid rgba(212,160,32,0.2);color:var(--silver);}
.stat-hero-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:16px;margin-bottom:20px;}
.stat-hero{background:var(--bg-card);border:1px solid var(--border-subtle);border-radius:10px;padding:18px;text-align:center;transition:transform 0.2s,border-color 0.2s;}
.stat-hero:hover{transform:translateY(-2px);border-color:var(--border-medium);}
.stat-hero .value{font-family:var(--font-display);font-size:1.8rem;font-weight:700;color:var(--text-primary);line-height:1;}
.stat-hero .label{font-family:var(--font-heading);font-size:0.7rem;font-weight:600;text-transform:uppercase;letter-spacing:0.5px;color:var(--text-tertiary);margin-top:6px;}
.career-path{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:20px;}
.career-node{display:flex;align-items:center;gap:4px;padding:4px 10px;background:rgba(255,255,255,0.04);border:1px solid var(--border-subtle);border-radius:6px;font-family:var(--font-heading);font-size:0.7rem;font-weight:600;color:var(--text-secondary);}
.career-node.current{background:var(--accent-dim);border-color:rgba(148,163,184,0.3);color:var(--silver);}
.career-arrow{color:var(--text-tertiary);font-size:0.8rem;}
.pos-map-wrap{background:var(--bg-card);border:1px solid var(--border-subtle);border-radius:12px;padding:20px;text-align:center;margin-bottom:20px;position:relative;overflow:hidden;}
.pos-map-wrap svg{max-width:100%;height:auto;border-radius:8px;display:block;margin:0 auto;background:#1a5a1a;}
.pos-map-caption{font-family:var(--font-heading);font-size:0.72rem;color:var(--text-tertiary);margin-top:10px;text-transform:uppercase;letter-spacing:0.5px;}
.attr-card{background:var(--bg-card);border:1px solid var(--border-subtle);border-radius:12px;padding:20px;}
.attr-card h3{font-family:var(--font-display);font-size:1rem;font-weight:600;text-transform:uppercase;margin-bottom:16px;color:var(--text-primary);}
.attr-row{display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid var(--border-subtle);flex-wrap:wrap;gap:4px;}
.attr-row:last-child{border-bottom:none;}
.attr-row .name{font-family:var(--font-body);font-size:0.82rem;color:var(--text-secondary);flex:1;}
.attr-row .score{font-family:var(--font-heading);font-size:0.85rem;font-weight:600;display:flex;align-items:center;gap:6px;white-space:nowrap;}
.ac-green{color:var(--success);}
.ac-yellow{color:var(--warning);}
.ac-red{color:var(--danger);}
.ac-pend{color:var(--pending);}
.circle{width:8px;height:8px;border-radius:50%;display:inline-block;}
.circle-green{background:var(--success);}
.circle-yellow{background:var(--warning);}
.circle-red{background:var(--danger);}
.circle-pend{background:var(--pending);}
.progress-bar{width:100%;height:6px;background:rgba(255,255,255,0.06);border-radius:3px;overflow:hidden;margin-top:4px;}
.progress-fill{height:100%;border-radius:3px;transition:width 1s ease;}
.t1-metric-row{display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid var(--border-subtle);flex-wrap:wrap;}
.t1-metric-row:last-child{border-bottom:none;}
.t1-metric-code{font-family:var(--font-heading);font-size:0.72rem;font-weight:700;color:var(--silver);width:60px;flex-shrink:0;text-transform:uppercase;}
.t1-metric-desc{font-size:0.78rem;color:var(--text-secondary);flex:1;}
.t1-metric-bar-wrap{width:100px;flex-shrink:0;}
.t1-metric-val{font-family:var(--font-heading);font-size:0.9rem;font-weight:700;color:var(--text-primary);width:70px;text-align:right;flex-shrink:0;}
.t1-group{margin-bottom:14px;}
.t1-group-head{font-family:var(--font-heading);font-size:0.65rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--text-tertiary);padding:6px 0;border-bottom:1px solid rgba(212,160,32,0.08);margin-bottom:8px;}
.philo-row{display:flex;align-items:center;gap:12px;padding:10px 0;border-bottom:1px solid var(--border-subtle);}
.philo-row:last-child{border-bottom:none;}
.philo-rank{font-family:var(--font-display);font-size:1.1rem;font-weight:700;color:var(--text-tertiary);width:28px;text-align:center;}
.philo-name{flex:1;font-family:var(--font-body);font-size:0.85rem;color:var(--text-primary);}
.philo-score{font-family:var(--font-heading);font-size:0.9rem;font-weight:700;color:var(--gold);width:36px;text-align:right;}
.philo-bar-wrap{width:120px;}
.match-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;}
.match-card{background:var(--bg-card);border:1px solid var(--border-subtle);border-radius:12px;overflow:hidden;transition:transform 0.2s,border-color 0.2s;text-decoration:none;color:inherit;display:block;cursor:pointer;}
.match-card:hover{transform:translateY(-3px);border-color:var(--silver);box-shadow:0 8px 24px rgba(212,160,32,0.1);}
.match-thumb{height:120px;background:linear-gradient(135deg,var(--bg-card-hover) 0%,var(--bg-card) 100%);display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden;background-size:cover;background-position:center;}
.match-thumb .play-icon{width:48px;height:48px;background:rgba(212,160,32,0.3);border-radius:50%;display:flex;align-items:center;justify-content:center;position:relative;z-index:2;border:2px dashed rgba(212,160,32,0.3);}
.match-thumb .play-icon svg{width:18px;height:18px;fill:rgba(255,255,255,0.3);margin-left:3px;}
.match-info{padding:16px;}
.match-teams{font-family:var(--font-heading);font-size:0.9rem;font-weight:600;color:var(--text-primary);margin-bottom:4px;line-height:1.3;}
.match-meta{font-family:var(--font-body);font-size:0.75rem;color:var(--text-tertiary);display:flex;gap:8px;flex-wrap:wrap;}
.match-badge{display:inline-block;padding:2px 6px;border-radius:4px;font-size:0.65rem;font-weight:600;text-transform:uppercase;}
.badge-verified{background:rgba(0,208,132,0.12);color:var(--success);}
.badge-comp{background:rgba(59,130,246,0.12);color:var(--info);}
.badge-pending{background:rgba(90,96,112,0.12);color:var(--pending);}
.data-table{width:100%;border-collapse:collapse;font-size:0.82rem;}
.data-table th{text-align:left;padding:10px 12px;font-family:var(--font-heading);font-weight:600;text-transform:uppercase;font-size:0.7rem;letter-spacing:0.5px;color:var(--text-tertiary);border-bottom:1px solid var(--border-medium);background:rgba(255,255,255,0.02);}
.data-table td{padding:10px 12px;border-bottom:1px solid var(--border-subtle);color:var(--text-secondary);}
.data-table tr:hover td{background:rgba(255,255,255,0.02);color:var(--text-primary);}
.data-table td strong{color:var(--text-primary);font-weight:600;}
.data-table .season-highlight{background:rgba(212,160,32,0.08);}
.scout-box{border-radius:10px;padding:18px;margin-bottom:16px;}
.scout-box h4{font-family:var(--font-display);font-size:0.9rem;font-weight:600;text-transform:uppercase;margin-bottom:10px;display:flex;align-items:center;gap:8px;}
.scout-pos{background:rgba(0,208,132,0.06);border:1px solid rgba(0,208,132,0.15);}
.scout-pos h4{color:var(--success);}
.scout-caut{background:rgba(255,184,0,0.06);border:1px solid rgba(255,184,0,0.15);}
.scout-caut h4{color:var(--warning);}
.scout-gap{background:rgba(255,59,59,0.06);border:1px solid rgba(255,59,59,0.15);}
.scout-gap h4{color:var(--danger);}
.scout-verdict{background:var(--accent-dim);border:1px solid rgba(212,160,32,0.2);}
.scout-verdict h4{color:var(--silver);}
.scout-box ul{list-style:none;padding:0;margin:0;}
.scout-box li{padding:5px 0;font-size:0.82rem;color:var(--text-secondary);display:flex;flex-wrap:wrap;gap:8px;}
.scout-box li::before{content:'\2014';color:var(--text-tertiary);flex-shrink:0;}
.physical-card{background:linear-gradient(135deg,rgba(212,160,32,0.08) 0%,rgba(10,10,15,0.5) 100%);border:1px solid rgba(212,160,32,0.15);border-radius:12px;padding:20px;}
.physical-card h4{font-family:var(--font-display);font-size:0.9rem;font-weight:600;text-transform:uppercase;color:var(--silver);margin-bottom:12px;}
.physical-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;}
.physical-item{display:flex;justify-content:space-between;font-size:0.8rem;padding:6px 0;border-bottom:1px solid var(--border-subtle);}
.physical-item .label{color:var(--text-tertiary);}
.physical-item .value{color:var(--text-primary);font-weight:600;}
.timeline{position:relative;padding-left:24px;}
.timeline::before{content:'';position:absolute;left:7px;top:4px;bottom:4px;width:2px;background:var(--border-subtle);border-radius:1px;}
.timeline-item{position:relative;padding-bottom:20px;}
.timeline-item:last-child{padding-bottom:0;}
.timeline-item::before{content:'';position:absolute;left:-21px;top:5px;width:10px;height:10px;border-radius:50%;background:var(--bg-card);border:2px solid var(--accent);z-index:2;}
.timeline-item.current::before{background:var(--accent);box-shadow:0 0 8px rgba(212,160,32,0.4);}
.timeline-item.hist::before{background:var(--success);border-color:var(--success);}
