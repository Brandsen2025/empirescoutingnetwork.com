function updateSeason() {
  var sel = document.getElementById('seasonSelect');
  if (!sel) return;
  var id = sel.value;
  var season = careerSeasons.find(function(s){return s.id === id;});
  if (!season) return;

  var hb = document.getElementById('heroBadge'); if (hb) hb.textContent = season.badge;
  var hc = document.getElementById('heroCaps'); if (hc) hc.textContent = season.caps || '—';

  var g = season.goals !== null ? season.goals : '-';
  var a = season.assists !== null ? season.assists : '-';
  var ap = season.apps !== null ? season.apps : '-';

  var tags = [
    {class: season.fga !== null ? 'tag-warning' : 'tag-pending', text: season.t3Status},
    {class:'tag-club', text:season.club},
    {class:'tag-value', text:g + 'G + ' + a + 'A'},
    {class:'tag-info', text:season.league}
  ];
  if (season.fga !== null) tags.push({class:'tag-warning', text:'FGA 7.3–7.9 PROVISIONAL'});
  renderTags(tags, 'heroTags');

  renderCareerPath(['Barca Residency','Cal State San Bernardino','Las Vegas Lights','Tacoma Defiance','El Paso','Colorado Springs'], 'careerPath');

  renderHeroStats([
    {value: season.fga !== null ? '7.3–7.9' : '-', label:'FGA Provisional', color:'var(--gold)'},
    {value:ap, label:'Apps', color:'var(--text-primary)'},
    {value:g, label:'Goals', color:'var(--success)'},
    {value:a, label:'Assists', color:'var(--info)'},
    {value:season.age, label:'Age', color:'var(--text-primary)'},
    {value:season.minutes !== null ? season.minutes : '-', label:'Minutes', color:'var(--text-primary)'}
  ], 'heroStatsGrid');

  renderKeyStrengths([
    {label:'T3 Average', value:'7.79'},
    {label:'OBI Composite', value:'7.64'},
    {label:'SII Composite', value:'7.57'},
    {label:'Apps (season)', value:ap}
