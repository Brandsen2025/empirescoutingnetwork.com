    card.innerHTML = '<div class="match-thumb" style="background-image:url(\''+m.thumb+'\');"><div class="play-icon" style="background:rgba(0,0,0,0.5);"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></div></div><div class="match-info"><div class="match-teams">'+m.title+'</div><div class="match-meta"><span class="match-badge badge-comp">'+m.meta+'</span><span class="match-badge badge-verified">'+m.badge+'</span></div><div style="font-size:0.72rem;color:var(--text-tertiary);margin-top:6px;line-height:1.4;">'+m.desc+'</div></div>';
    grid.appendChild(card);
  });
}

